# 회원가입팀 DB(blood_link.db)를 직접 공유해서 읽는다. inbuild_mid 레포와 같은 위치에서
# 실행하면 상대경로로 충분하고, 아니라면 절대경로로 지정할 것.
SHARED_DB_PATH=./blood_link.db

# 회원가입팀(inbuild_mid)의 .env에 있는 JWT_SECRET_KEY와 반드시 같은 값을 넣을 것.
# 값이 다르면 로그인은 되지만 이 백엔드의 모든 요청이 401로 떨어진다.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# 이 백엔드 자체 DB (알림 설정 등) - blood_link.db와는 별도 파일
DATABASE_URL=sqlite:///./home_settings.db

# 실제 푸시 발송(FCM)용 Firebase 서비스 계정 키 JSON 경로. Firebase 콘솔 > 프로젝트 설정 >
# 서비스 계정 > "새 비공개 키 생성"으로 발급받는다. 절대 저장소에 커밋하지 말 것.
# 비워두면 알림 배치는 그대로 돌지만 발송 시점에 경고 로그만 남기고 건너뛴다.
FCM_CREDENTIALS_PATH=

# 예측 기반 '혈액 부족' 알림 배치를 매일 실행할 시각 (0~23, 서버 로컬 시간)
NOTIFICATION_BATCH_HOUR=9
